#!/bin/bash
# cmux-voice-say: speak one chosen headline in the same voice as
# cmux-voice-reporter. An orchestrator session calls it to read out only the
# reports that matter, alongside (or instead of) the per-pane announcements.
#
#   cmux-voice-say "api tests pushed; the flaky case now passes"
#   touch ~/.cache/cmux-voice/master-mute   # silence; delete to unmute
#   VOICE, FALLBACK_VOICE, KOKORO_HOST, QWEN_*: as for cmux-voice-reporter
#   VOICE_TAG=master       # tag for the spoken.log line
#   VOICE_LOCK_WAIT=30     # seconds to wait for another speaker; 0 = skip if busy
# Exits 3 when it skipped because another line was still playing.
set -u
state=~/.cache/cmux-voice; mkdir -p "$state"
[[ -e "$state/master-mute" ]] && exit 0
voice=${VOICE:-qwen:airy}
fallback=${FALLBACK_VOICE:-af_nicole jf_alpha Samantha}
kokoro_host=${KOKORO_HOST:-}
qwen_model=${QWEN_MODEL:-mlx-community/Qwen3-TTS-12Hz-0.6B-Base-bf16}
qwen_dir=${QWEN_VOICE_DIR:-$HOME/.local/share/cmux-voice/voices}   # path on the server
qwen_timeout=${QWEN_TIMEOUT:-15}
tag=${VOICE_TAG:-master}
text=$*
[[ -z "$text" ]] && { echo "usage: cmux-voice-say <headline>" >&2; exit 2; }

# One speaker at a time across the reporter, cmux-voice-say and the nudge.
lock=$state/speaking.lock
take_lock() {  # $1: seconds to wait
  local waited=0 pid
  until mkdir "$lock" 2>/dev/null; do
    pid=$(cat "$lock/pid" 2>/dev/null)
    if { [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; } ||
       [[ -n $(find "$lock" -maxdepth 0 -mmin +2 2>/dev/null) ]]; then
      rm -rf "$lock"; continue
    fi
    (( waited++ >= $1 )) && return 1
    sleep 1
  done
  echo $$ >"$lock/pid"
  trap 'rm -rf "$lock"' EXIT
}
take_lock "${VOICE_LOCK_WAIT:-30}" || exit 3
printf '%s\t%s\t%s\n' "$(date +%T)" "$tag" "$text" >>"$state/spoken.log"


# Voices: "qwen:<name>" clones $qwen_dir/<name>.wav (on the server) with
# Qwen3-TTS; af_nicole / bm_george style names (optionally comma-blended) are
# Kokoro; anything else is a macOS `say` voice.
is_kokoro() { [[ "$1" =~ ^[a-z][fm]_[a-z]+(,[a-z][fm]_[a-z]+)*$ ]]; }
engine() { if [[ "$1" == qwen:* ]]; then echo qwen; elif is_kokoro "$1"; then echo kokoro; else echo say; fi; }

tts_post() {  # $1: max seconds; stdin: JSON request, stdout: wav
  local cmd="curl -sf --max-time $1 -X POST http://127.0.0.1:8880/v1/audio/speech -H content-type:application/json -d @-"
  if [[ -n "$kokoro_host" ]]; then
    ssh -o BatchMode=yes -o ConnectTimeout=3 "$kokoro_host" "$cmd"
  else
    eval "$cmd"
  fi
}

tts_wav() {  # $1: text, $2: wav path, $3: voice, $4: tries. On failure $why and $rc say why.
  local try req limit
  if [[ "$3" == qwen:* ]]; then
    limit=$qwen_timeout
    req=$(jq -n --arg t "$1" --arg m "$qwen_model" --arg r "$qwen_dir/${3#qwen:}.wav" \
      '{model:$m, input:$t, ref_audio:$r, response_format:"wav"}')
  else
    limit=60
    req=$(jq -n --arg t "$1" --arg v "$3" \
      '{model:"mlx-community/Kokoro-82M-bf16", input:$t, voice:$v, response_format:"wav"}')
  fi
  for (( try = 1; try <= $4; try++ )); do
    tts_post "$limit" <<<"$req" >"$2" 2>/dev/null
    rc=$?
    [[ $rc -eq 0 && -s "$2" ]] && return 0
    case $rc in
      0) why="empty audio" ;;
      7) why="server not listening on 8880" ;;
      22) why="server returned an HTTP error" ;;
      28) why="no reply within $limit s" ;;
      255) why="ssh to $kokoro_host failed" ;;
      *) why="request exited $rc" ;;
    esac
  done
  (( $4 > 1 )) && why+=", after a retry"
  return 1
}

# Speak $1 in $voice, else in each $fallback voice in turn. A Kokoro first voice
# gets one retry; Qwen gets one try within $qwen_timeout. After a failure the
# rest of that engine is skipped, and an unreachable server skips both engines.
speak_chain() {  # $1: text, $2: wav path
  local v e tries skip=" " reasons= first=1
  for v in "$voice" $fallback; do
    e=$(engine "$v")
    [[ "$skip" == *" $e "* ]] && continue
    if [[ "$e" == say ]]; then
      [[ -n "$reasons" ]] && log_fallback "${reasons}using $v"
      say -v "$v" -- "$1"; return
    fi
    tries=1; [[ -n "$first" && "$e" == kokoro ]] && tries=2
    if tts_wav "$1" "$2" "$v" "$tries"; then
      [[ -n "$reasons" ]] && log_fallback "${reasons}using $v"
      afplay "$2"; return
    fi
    reasons+="$v: $why; "
    skip+="$e "
    case $rc in 7|255) skip+="kokoro qwen " ;; esac
    first=
  done
  log_fallback "${reasons}using Samantha"
  say -v Samantha -- "$1"
}

log_fallback() {
  printf '%s\tkokoro fallback: %s\n' "$(date +%T)" "$1" >>"$state/spoken.log"
  echo "$(date +%T) kokoro fallback: $1"
}

speak_chain "$text" "$state/$tag-line.wav" >/dev/null
