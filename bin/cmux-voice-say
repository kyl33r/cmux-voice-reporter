#!/bin/bash
# cmux-voice-say: speak one chosen headline in the same voice as
# cmux-voice-reporter. An orchestrator session calls it to read out only the
# reports that matter, alongside (or instead of) the per-pane announcements.
#
#   cmux-voice-say "api tests pushed; the flaky case now passes"
#   touch ~/.cache/cmux-voice/master-mute   # silence; delete to unmute
#   VOICE, FALLBACK_VOICE, KOKORO_HOST: as for cmux-voice-reporter
#   VOICE_TAG=master       # tag for the spoken.log line
#   VOICE_LOCK_WAIT=30     # seconds to wait for another speaker; 0 = skip if busy
# Exits 3 when it skipped because another line was still playing.
set -u
state=~/.cache/cmux-voice; mkdir -p "$state"
[[ -e "$state/master-mute" ]] && exit 0
voice=${VOICE:-af_nicole}
fallback=${FALLBACK_VOICE:-Samantha}
kokoro_host=${KOKORO_HOST:-}
tag=${VOICE_TAG:-master}
text=$*
[[ -z "$text" ]] && { echo "usage: cmux-voice-say <headline>" >&2; exit 2; }

# One speaker at a time across the reporter, cmux-voice-say and the nudge.
lock=$state/speaking.lock
take_lock() {  # $1: seconds to wait
  local waited=0 pid
  until mkdir "$lock" 2>/dev/null; do
    pid=$(cat "$lock/pid" 2>/dev/null)
    if { [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; } ||
       [[ -n $(find "$lock" -maxdepth 0 -mmin +2 2>/dev/null) ]]; then
      rm -rf "$lock"; continue
    fi
    (( waited++ >= $1 )) && return 1
    sleep 1
  done
  echo $$ >"$lock/pid"
  trap 'rm -rf "$lock"' EXIT
}
take_lock "${VOICE_LOCK_WAIT:-30}" || exit 3
printf '%s\t%s\t%s\n' "$(date +%T)" "$tag" "$text" >>"$state/spoken.log"

kokoro_post() {  # stdin: JSON request, stdout: wav
  local cmd='curl -sf --max-time 60 -X POST http://127.0.0.1:8880/v1/audio/speech -H content-type:application/json -d @-'
  if [[ -n "$kokoro_host" ]]; then
    ssh -o BatchMode=yes -o ConnectTimeout=3 "$kokoro_host" "$cmd"
  else
    eval "$cmd"
  fi
}

# Kokoro voices look like af_nicole / bm_george (optionally comma-blended).
kokoro_voice() { [[ "$voice" =~ ^[a-z][fm]_[a-z]+(,[a-z][fm]_[a-z]+)*$ ]]; }

kokoro_wav() {  # $1: text, $2: wav path. One retry; on failure $why says why.
  local try rc
  for try in 1 2; do
    jq -n --arg t "$1" --arg v "$voice" \
      '{model:"mlx-community/Kokoro-82M-bf16", input:$t, voice:$v, response_format:"wav"}' |
      kokoro_post >"$2" 2>/dev/null
    rc=$?
    [[ $rc -eq 0 && -s "$2" ]] && return 0
    case $rc in
      0) why="empty audio" ;;
      7) why="server not listening on 8880" ;;
      22) why="server returned an HTTP error" ;;
      28) why="no reply within 60 s" ;;
      255) why="ssh to $kokoro_host failed" ;;
      *) why="request exited $rc" ;;
    esac
  done
  why+=", after a retry"
  return 1
}

log_fallback() {
  printf '%s\tkokoro fallback: %s\n' "$(date +%T)" "$why" >>"$state/spoken.log"
  echo "$(date +%T) kokoro fallback: $why"
}

wav="$state/$tag-line.wav"
if ! kokoro_voice; then
  say -v "$voice" -- "$text"
elif kokoro_wav "$text" "$wav"; then
  afplay "$wav"
else
  log_fallback >/dev/null
  say -v "$fallback" -- "$text"
fi
