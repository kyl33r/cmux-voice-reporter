#!/bin/bash
# cmux-voice-reporter: one speaker for all panes, fed by cmux's notification
# stream (one event per finished top-level Claude turn; subagents suppressed).
# Run it in its own cmux pane, never as a Claude background task: a tracked
# task stops its owner's Stop hook from firing.
#
#   VOICE=af_bella cmux-voice-reporter          # any Kokoro voice (af_heart, bf_emma,
#                                                # blends like "af_heart,jf_alpha")
#   VOICE=Samantha cmux-voice-reporter          # or any macOS `say` voice
#   FALLBACK_VOICE="jf_alpha Samantha"           # tried in order if VOICE fails
#   KOKORO_HOST=my-mini.local                    # ssh host running the Kokoro server
#                                                # (unset: server on this machine)
#   VOICE_SKIP_SURFACE=<uuid>                    # surface to stay silent for
#   touch ~/.cache/cmux-voice/mute               # mute; rm to unmute
#   --once                                       # exit after first spoken line
set -u
state=~/.cache/cmux-voice; mkdir -p "$state"
voice=${VOICE:-af_nicole}
fallback=${FALLBACK_VOICE:-jf_alpha Samantha}
kokoro_host=${KOKORO_HOST:-}
skip=${VOICE_SKIP_SURFACE:-}
once=; [[ "${1:-}" == --once ]] && once=1

now_ms() { perl -MTime::HiRes=time -e 'printf "%.3f", time'; }

kokoro_post() {  # stdin: JSON request, stdout: wav
  local cmd='curl -sf --max-time 60 -X POST http://127.0.0.1:8880/v1/audio/speech -H content-type:application/json -d @-'
  if [[ -n "$kokoro_host" ]]; then
    ssh -o BatchMode=yes -o ConnectTimeout=3 "$kokoro_host" "$cmd"
  else
    eval "$cmd"
  fi
}

# One speaker at a time across the reporter, cmux-voice-say and the nudge.
lock=$state/speaking.lock
take_lock() {  # $1: seconds to wait
  local waited=0 pid
  until mkdir "$lock" 2>/dev/null; do
    pid=$(cat "$lock/pid" 2>/dev/null)
    if { [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; } ||
       [[ -n $(find "$lock" -maxdepth 0 -mmin +2 2>/dev/null) ]]; then
      rm -rf "$lock"; continue
    fi
    (( waited++ >= $1 )) && return 1
    sleep 1
  done
  echo $$ >"$lock/pid"
}

# Kokoro voices look like af_nicole / bm_george (optionally comma-blended).
is_kokoro() { [[ "$1" =~ ^[a-z][fm]_[a-z]+(,[a-z][fm]_[a-z]+)*$ ]]; }

kokoro_wav() {  # $1: text, $2: wav path, $3: voice, $4: tries. On failure $why and $rc say why.
  local try
  for (( try = 1; try <= $4; try++ )); do
    jq -n --arg t "$1" --arg v "$3" \
      '{model:"mlx-community/Kokoro-82M-bf16", input:$t, voice:$v, response_format:"wav"}' |
      kokoro_post >"$2" 2>/dev/null
    rc=$?
    [[ $rc -eq 0 && -s "$2" ]] && return 0
    case $rc in
      0) why="empty audio" ;;
      7) why="server not listening on 8880" ;;
      22) why="server returned an HTTP error" ;;
      28) why="no reply within 60 s" ;;
      255) why="ssh to $kokoro_host failed" ;;
      *) why="request exited $rc" ;;
    esac
  done
  (( $4 > 1 )) && why+=", after a retry"
  return 1
}

# Speak $1 in $voice, else in each $fallback voice in turn (Kokoro or `say`).
# The first voice gets one retry. A server-level failure (down, unreachable,
# timed out) skips the remaining Kokoro voices, since they would fail the same way.
speak_chain() {  # $1: text, $2: wav path
  local v tries=2 down= reasons=
  for v in "$voice" $fallback; do
    if is_kokoro "$v"; then
      [[ -n "$down" ]] && continue
      if kokoro_wav "$1" "$2" "$v" "$tries"; then
        [[ -n "$reasons" ]] && log_fallback "${reasons}using $v"
        afplay "$2"; return
      fi
      reasons+="$v: $why; "
      case $rc in 7|28|255) down=1 ;; esac
    else
      [[ -n "$reasons" || "$v" != "$voice" ]] && log_fallback "${reasons}using $v"
      say -v "$v" -- "$1"; return
    fi
    tries=1
  done
  log_fallback "${reasons}using Samantha"
  say -v Samantha -- "$1"
}

log_fallback() {
  printf '%s\tkokoro fallback: %s\n' "$(date +%T)" "$1" >>"$state/spoken.log"
  echo "$(date +%T) kokoro fallback: $1"
}

speak() { speak_chain "$1" "$state/line.wav"; }

headline() {  # first sentence, markdown stripped, capped at ~120 bytes on a word
  sed -E 's/\[([^]]*)\]\([^)]*\)/\1/g; s/[*`#_>|]//g; s/  +/ /g; s/^ +//' <<<"$1" |
    LC_ALL=C awk '{ if (match($0, /[.!?]( |$)/)) $0 = substr($0, 1, RSTART)
           if (length($0) > 120) { s = substr($0, 1, 120); sub(/ [^ ]*$/, "", s); $0 = s }
           print }' |
    iconv -c -f UTF-8 -t UTF-8 2>/dev/null  # the byte cut (here or cmux's) can split a character
}

# row: idx:nid|workspace|surface|state|title|subtitle|BODY (may hold '|')|ts|pct:<workspace title>
parse_row() {
  local rest=${1#*|*|*|*|*|*|}
  workspace=${rest##*|pct:}
  rest=${rest%|pct:*}
  body=${rest%|*}
}

# On any exit, stop our children (the events reader's subshell and its
# `cmux events`, or a playing afplay) and drop the lock if we hold it.
cleanup() {
  local c
  for c in $(pgrep -P $$); do pkill -P "$c"; kill "$c"; done 2>/dev/null
  [[ "$(cat "$lock/pid" 2>/dev/null)" == $$ ]] && rm -rf "$lock"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

echo "voice reporter: voice=\"$voice\" skip=$skip mute=$state/mute"
while read -r ev; do
  nid=$(jq -r '.payload.notification_id // empty' <<<"$ev")
  sid=$(jq -r '.surface_id // empty' <<<"$ev")
  ended=$(jq -r '.occurred_at' <<<"$ev")
  [[ -z "$nid" || "$sid" == "$skip" ]] && continue
  [[ -n "${VOICE_ONLY_SURFACE:-}" && "$sid" != "$VOICE_ONLY_SURFACE" ]] && continue
  [[ -e "$state/mute" ]] && { echo "$(date +%T) muted, skipped $sid"; continue; }
  row=$(cmux list-notifications 2>/dev/null | grep -F "|$sid|" | grep -F ":$nid|" | head -1)
  [[ -z "$row" ]] && continue
  parse_row "$row"
  tree=$(cmux --id-format both tree --all --json 2>/dev/null)
  pane=$(jq -r --arg s "$sid" 'first(.. | objects | select(.id? == $s) | .title) // empty' <<<"$tree")
  same=$(jq -r --arg t "$pane" '[.. | objects | select(.ref? | strings | startswith("surface:")) | select(.title == $t)] | length' <<<"$tree")
  name=${pane:-$workspace}
  [[ -n "$pane" && "$same" -gt 1 ]] && name="$workspace, $pane"
  line="$name finished: $(headline "$body")"
  printf '%s\tturn_end=%s\tspeak_start=%s\t%s\n' "$(date +%T)" "$ended" "$(now_ms)" "$line" >>"$state/spoken.log"
  echo "$(date +%T) $line"
  if take_lock 30; then speak "$line"; rm -rf "$lock"
  else echo "$(date +%T) lock still held after 30s, speaking anyway"; speak "$line"; fi
  [[ -n "$once" ]] && break
done < <(cmux events --name notification.created --no-ack --no-heartbeat \
           --reconnect --cursor-file "$state/seq")
