#!/bin/bash
# cmux-voice-reporter: one speaker for all panes, fed by cmux's notification
# stream (one event per finished top-level Claude turn; subagents suppressed).
# Run it in its own cmux pane, never as a Claude background task: a tracked
# task stops its owner's Stop hook from firing.
#
#   VOICE=qwen:airy (default)                    # Qwen3-TTS clone of voices/airy.wav;
#                                                # also qwen:whisper, qwen:airy-jp
#   VOICE=af_bella cmux-voice-reporter          # any Kokoro voice (af_heart, bf_emma,
#                                                # blends like "af_heart,jf_alpha")
#   VOICE=Samantha cmux-voice-reporter          # or any macOS `say` voice
#   FALLBACK_VOICE="af_nicole jf_alpha Samantha" # tried in order if VOICE fails
#   QWEN_TIMEOUT=15  QWEN_VOICE_DIR=<dir on the server>  QWEN_MODEL=<repo id>
#   ~/.config/cmux-voice/prefix.txt, suffix.txt  # phrases said before/after each line,
#                                                # one picked at random; edits apply at once
#   PAUSE_MEDIA=0                                # leave music playing while speaking
#   KOKORO_HOST=my-mini.local                    # ssh host running the Kokoro server
#                                                # (unset: server on this machine)
#   VOICE_SKIP_SURFACE=<uuid>                    # surface to stay silent for
#   touch ~/.cache/cmux-voice/mute               # mute; rm to unmute
#   --once                                       # exit after first spoken line
set -u
state=~/.cache/cmux-voice; mkdir -p "$state"
voice=${VOICE:-qwen:airy}
fallback=${FALLBACK_VOICE:-af_nicole jf_alpha Samantha}
kokoro_host=${KOKORO_HOST:-}
qwen_model=${QWEN_MODEL:-mlx-community/Qwen3-TTS-12Hz-0.6B-Base-bf16}
qwen_dir=${QWEN_VOICE_DIR:-$HOME/.local/share/cmux-voice/voices}   # path on the server
qwen_timeout=${QWEN_TIMEOUT:-15}
phrases=${VOICE_PHRASES_DIR:-$HOME/.config/cmux-voice}   # prefix.txt, suffix.txt
skip=${VOICE_SKIP_SURFACE:-}
once=; [[ "${1:-}" == --once ]] && once=1

now_ms() { perl -MTime::HiRes=time -e 'printf "%.3f", time'; }


# One speaker at a time across the reporter, cmux-voice-say and the nudge.
lock=$state/speaking.lock
take_lock() {  # $1: seconds to wait
  local waited=0 pid
  until mkdir "$lock" 2>/dev/null; do
    pid=$(cat "$lock/pid" 2>/dev/null)
    if { [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; } ||
       [[ -n $(find "$lock" -maxdepth 0 -mmin +2 2>/dev/null) ]]; then
      rm -rf "$lock"; continue
    fi
    (( waited++ >= $1 )) && return 1
    sleep 1
  done
  echo $$ >"$lock/pid"
}

# Voices: "qwen:<name>" clones $qwen_dir/<name>.wav (on the server) with
# Qwen3-TTS; af_nicole / bm_george style names (optionally comma-blended) are
# Kokoro; anything else is a macOS `say` voice.
is_kokoro() { [[ "$1" =~ ^[a-z][fm]_[a-z]+(,[a-z][fm]_[a-z]+)*$ ]]; }
engine() { if [[ "$1" == qwen:* ]]; then echo qwen; elif is_kokoro "$1"; then echo kokoro; else echo say; fi; }

tts_post() {  # $1: max seconds; stdin: JSON request, stdout: wav
  local cmd="curl -sf --max-time $1 -X POST http://127.0.0.1:8880/v1/audio/speech -H content-type:application/json -d @-"
  if [[ -n "$kokoro_host" ]]; then
    # curl's limit doesn't cover ssh login, which crawls on a swapping server;
    # alarm bounds the whole call (exit 142 counts as a timeout below).
    perl -e 'alarm shift; exec @ARGV' $(( $1 + 5 )) \
      ssh -o BatchMode=yes -o ConnectTimeout=3 "$kokoro_host" "$cmd"
  else
    eval "$cmd"
  fi
}

tts_wav() {  # $1: text, $2: wav path, $3: voice, $4: tries. On failure $why and $rc say why.
  local try req limit
  if [[ "$3" == qwen:* ]]; then
    limit=$qwen_timeout
    req=$(jq -n --arg t "$1" --arg m "$qwen_model" --arg r "$qwen_dir/${3#qwen:}.wav" \
      '{model:$m, input:$t, ref_audio:$r, response_format:"wav"}')
  else
    limit=60
    req=$(jq -n --arg t "$1" --arg v "$3" \
      '{model:"mlx-community/Kokoro-82M-bf16", input:$t, voice:$v, response_format:"wav"}')
  fi
  for (( try = 1; try <= $4; try++ )); do
    tts_post "$limit" <<<"$req" >"$2" 2>/dev/null
    rc=$?
    [[ $rc -eq 0 && -s "$2" ]] && return 0
    case $rc in
      0) why="empty audio" ;;
      7) why="server not listening on 8880" ;;
      22) why="server returned an HTTP error" ;;
      28|142) why="no reply within $limit s" ;;
      255) why="ssh to $kokoro_host failed" ;;
      *) why="request exited $rc" ;;
    esac
  done
  (( $4 > 1 )) && why+=", after a retry"
  return 1
}

# Synthesize $1 into $2 with $voice, else each $fallback voice in turn. Returns 0
# with the wav ready, or 1 with $say_voice set for a `say` voice. A Kokoro first
# voice gets one retry; Qwen gets one try within $qwen_timeout. A failed engine
# joins $skip for the rest of the line; an unreachable server skips both engines.
synth_chain() {  # $1: text, $2: wav path
  local v e tries reasons='' first=1
  for v in "$voice" $fallback; do
    e=$(engine "$v")
    [[ "$skip" == *" $e "* ]] && continue
    if [[ "$e" == say ]]; then
      [[ -n "$reasons" ]] && log_fallback "${reasons}using $v"
      say_voice=$v; return 1
    fi
    tries=1; [[ -n "$first" && "$e" == kokoro ]] && tries=2
    if tts_wav "$1" "$2" "$v" "$tries"; then
      [[ -n "$reasons" ]] && log_fallback "${reasons}using $v"
      return 0
    fi
    reasons+="$v: $why; "
    skip+="$e "
    case $rc in 7|255) skip+="kokoro qwen " ;; esac
    first=
  done
  log_fallback "${reasons}using Samantha"
  say_voice=Samantha; return 1
}

chunks() {  # one line per sentence; tiny ones merged, ones over ~25 words cut at a comma
  perl -CSD -e '
    my $t = join " ", <STDIN>; $t =~ s/\s+/ /g; $t =~ s/^ | $//g;
    my @out; my $cur = "";
    for my $s (split /(?<=[.!?;:])\s+/, $t) {
      my @parts = ($s);
      if (split(/ /, $s) > 25) { @parts = split /(?<=,)\s+/, $s }
      for my $p (@parts) {
        if ($cur ne "" && split(/ /, "$cur $p") > 25 && split(/ /, $cur) >= 4) { push @out, $cur; $cur = $p }
        else { $cur = $cur eq "" ? $p : "$cur $p" }
      }
    }
    push @out, $cur if $cur ne "";
    print "$_\n" for @out;' <<<"$1"
}

# Pause whatever is playing (any app in macOS Now Playing) while we speak, and
# resume only what we paused. Needs media-control (brew install media-control).
media_paused=
media_pause() {
  [[ "${PAUSE_MEDIA:-1}" == 1 && -z "$media_paused" ]] && command -v media-control >/dev/null || return 0
  media-control get 2>/dev/null | jq -e '.playing == true' >/dev/null || return 0
  media-control pause && media_paused=1
}
media_resume() { [[ -n "${media_paused:-}" ]] && media-control play; media_paused=; }

# A random phrase from a file, one per line (# comments and blank lines skipped;
# a line "-" means say nothing). Read on every line, so edits apply at once.
pick() {
  local l a=()
  [[ -r "$1" ]] || return 0
  while IFS= read -r l || [[ -n "$l" ]]; do
    l=$(sed -E 's/^[[:space:]]+|[[:space:]]+$//g' <<<"$l")
    [[ -z "$l" || "$l" == \#* ]] || a+=("$l")
  done <"$1"
  (( ${#a[@]} )) || return 0
  l=${a[RANDOM % ${#a[@]}]}
  [[ "$l" == - ]] || printf '%s' "$l"
}

# Playback level for afplay (0.00-1.00) from VOICE_VOLUME or the volume file
# (0-100, set with cmux-voice-volume). Re-read every line; bad values mean 100.
volume() {
  local v=${VOICE_VOLUME:-}
  [[ -z "$v" && -r "$phrases/volume" ]] && v=$(tr -dc 0-9 <"$phrases/volume")
  [[ "$v" =~ ^[0-9]+$ ]] && (( 10#$v <= 100 )) || v=100
  awk -v p="$((10#$v))" 'BEGIN { printf "%.2f", p / 100 }'
}

# Speak $1 a sentence at a time: synthesize the next chunk while the current one
# plays, so long lines stay inside the Qwen limit and start sooner.
speak_text() {  # $1: text, $2: wav path prefix
  local chunk i=0 player='' skip=" " say_voice pre post vol
  vol=$(volume)
  pre=$(pick "$phrases/prefix.txt"); post=$(pick "$phrases/suffix.txt")
  while IFS= read -r chunk; do
    i=$((i + 1))
    if synth_chain "$chunk" "$2.$i.wav"; then
      [[ -n "$player" ]] && wait "$player"
      media_pause; afplay -v "$vol" "$2.$i.wav" & player=$!
    else
      [[ -n "$player" ]] && wait "$player"; player=
      media_pause
      say -v "$say_voice" -o "$2.$i.aiff" -- "$chunk" && afplay -v "$vol" "$2.$i.aiff"
    fi
  done < <(chunks "${pre:+$pre }$1${post:+ $post}")
  [[ -n "$player" ]] && wait "$player"
  media_resume
  rm -f "$2".*.wav "$2".*.aiff
}

log_fallback() {
  printf '%s\tkokoro fallback: %s\n' "$(date +%T)" "$1" >>"$state/spoken.log"
  echo "$(date +%T) kokoro fallback: $1"
}

speak() { speak_text "$1" "$state/line"; }

headline() {  # first sentence, markdown stripped, capped at ~120 bytes on a word
  sed -E 's/\[([^]]*)\]\([^)]*\)/\1/g; s/[*`#_>|]//g; s/  +/ /g; s/^ +//' <<<"$1" |
    LC_ALL=C awk '{ if (match($0, /[.!?]( |$)/)) $0 = substr($0, 1, RSTART)
           if (length($0) > 120) { s = substr($0, 1, 120); sub(/ [^ ]*$/, "", s); $0 = s }
           print }' |
    iconv -c -f UTF-8 -t UTF-8 2>/dev/null  # the byte cut (here or cmux's) can split a character
}

# row: idx:nid|workspace|surface|state|title|subtitle|BODY (may hold '|')|ts|pct:<workspace title>
parse_row() {
  local rest=${1#*|*|*|*|*|*|}
  workspace=${rest##*|pct:}
  rest=${rest%|pct:*}
  body=${rest%|*}
}

# On any exit, stop our children (the events reader's subshell and its
# `cmux events`, or a playing afplay) and drop the lock if we hold it.
cleanup() {
  local c
  for c in $(pgrep -P $$); do pkill -P "$c"; kill "$c"; done 2>/dev/null
  [[ "$(cat "$lock/pid" 2>/dev/null)" == "$$" ]] && rm -rf "$lock"
  media_resume
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

echo "voice reporter: voice=\"$voice\" skip=$skip mute=$state/mute"
while read -r ev; do
  nid=$(jq -r '.payload.notification_id // empty' <<<"$ev")
  sid=$(jq -r '.surface_id // empty' <<<"$ev")
  ended=$(jq -r '.occurred_at' <<<"$ev")
  [[ -z "$nid" || "$sid" == "$skip" ]] && continue
  [[ -n "${VOICE_ONLY_SURFACE:-}" && "$sid" != "$VOICE_ONLY_SURFACE" ]] && continue
  [[ -e "$state/mute" ]] && { echo "$(date +%T) muted, skipped $sid"; continue; }
  row=$(cmux list-notifications 2>/dev/null | grep -F "|$sid|" | grep -F ":$nid|" | head -1)
  [[ -z "$row" ]] && continue
  parse_row "$row"
  tree=$(cmux --id-format both tree --all --json 2>/dev/null)
  pane=$(jq -r --arg s "$sid" 'first(.. | objects | select(.id? == $s) | .title) // empty' <<<"$tree")
  same=$(jq -r --arg t "$pane" '[.. | objects | select(.ref? | strings | startswith("surface:")) | select(.title == $t)] | length' <<<"$tree")
  name=${pane:-$workspace}
  [[ -n "$pane" && "$same" -gt 1 ]] && name="$workspace, $pane"
  line="$name finished: $(headline "$body")"
  printf '%s\tturn_end=%s\tspeak_start=%s\t%s\n' "$(date +%T)" "$ended" "$(now_ms)" "$line" >>"$state/spoken.log"
  echo "$(date +%T) $line"
  if take_lock 30; then speak "$line"; rm -rf "$lock"
  else echo "$(date +%T) lock still held after 30s, speaking anyway"; speak "$line"; fi
  [[ -n "$once" ]] && break
done < <(cmux events --name notification.created --no-ack --no-heartbeat \
           --reconnect --cursor-file "$state/seq")
